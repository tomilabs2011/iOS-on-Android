# shellcheck shell=bash
# Pinned versions for everything this project downloads.
# Every file is checked against its SHA-256 before it is used.
# Read by the Mac scripts (mac/) and the phone scripts (android/).

# ---- The one device we commit to -------------------------------------------
# Xiaomi Mi 10T Pro. Codename "apollo" on stock MIUI, "apollon" on most custom ROMs.
IOA_DEVICE_CODENAMES="apollo apollon apollopro"
IOA_DEVICE_NAME="Mi 10T Pro"

# ---- The one iOS version we commit to --------------------------------------
# iPhone OS 3.1.3 (build 7E18), Apple's own firmware, running on an emulated
# iPod touch 2nd generation (Samsung S5L8720 SoC, ARM1176 CPU, 320x480 screen).
IOA_IOS_VERSION="3.1.3"
IOA_IOS_BUILD="7E18"

# ---- Emulator: Light Touch / qemu-ios (QEMU fork) --------------------------
# Built from source on the phone. The tag is the latest release-tagged
# revision; the commit pins it so a moved tag can't silently change the code.
IOA_EMU_REPO="https://github.com/samhenrigold/qemu-ios.git"
IOA_EMU_TAG="ipod-touch-2g-2026.09.27.1"
IOA_EMU_COMMIT="567321152ac6efcbf3729dbf24299f1338b39fc9"

# ---- Firmware images (from the emulator project's 3.1.3 release) -----------
IOA_FW_URL="https://github.com/samhenrigold/qemu-ios/releases/download/ipod-touch-2g-2026.08"
IOA_FW_BOOTROM="bootrom_240_4"
IOA_FW_BOOTROM_SHA256="55f4d8ea2791ba51dd89934168f38f0fb21ce8762ff614c1e742407c0d3ca054"
IOA_FW_NOR="nor_7E18.bin"
IOA_FW_NOR_SHA256="6404a51cd4d52f055a91cf4a0e153203b9f3a71683d6af471797c7653858128c"
# "canonical" = the clean 3.1.3 image. (The appsync3 image's published
# checksum does not match the file on the release page, so we don't use it.)
IOA_FW_NAND="nand-canonical.tar.gz"
IOA_FW_NAND_SHA256="030251c4c8be6712d44b0d91ef60c9f1f38d86268a54e70738d055a81c252d61"
IOA_FW_NAND_DIR="nand-canonical"

# ---- Android apps (official GitHub releases) -------------------------------
IOA_TERMUX_URL="https://github.com/termux/termux-app/releases/download/v0.118.3/termux-app_v0.118.3+github-debug_arm64-v8a.apk"
IOA_TERMUX_SHA256="72fdb596045116bf5ba1b5bdf5b26fddb9acc0bd074ad9f2da9eb0ae85e83a4e"
IOA_AVNC_URL="https://github.com/gujjwal00/avnc/releases/download/v3.3.1/avnc-3.3.1.apk"
IOA_AVNC_SHA256="61cb507e9f334f0276eacc8e9574bae6934d18e59c96b49f900a1183637d8f88"

# Google's official adb/fastboot package for macOS (only used if adb is missing).
IOA_PLATFORM_TOOLS_URL="https://dl.google.com/android/repository/platform-tools-latest-darwin.zip"

# ---- Runtime ---------------------------------------------------------------
# Both listen on 127.0.0.1 only (not reachable from the network).
IOA_VNC_DISPLAY=1          # VNC display :1 = TCP port 5901
IOA_MONITOR_PORT=4444      # QEMU monitor, used to press the Home/Power buttons
IOA_GUEST_RAM="2G"         # the value the emulator's own docs use
IOA_PHONE_DIR="/sdcard/Download/ios-on-android"
